# SwarmGrid AI - Environment Variables
# Copy to .env.local and fill in values before deploying

# AI (required for smart recommendations)
NEXT_PUBLIC_GEMINI_API_KEY=

# API Base URL (auto-detected in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Free APIs (no key needed, override if using custom endpoints)
NEXT_PUBLIC_OPEN_METEO_API_URL=https://api.open-meteo.com/v1
NEXT_PUBLIC_NASA_POWER_API_URL=https://power.larc.nasa.gov/api/v1
