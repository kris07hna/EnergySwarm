# =============================================================================
# SwarmGrid AI - Environment Configuration (Free & Gemini APIs Only)
# Research-Grade Energy Grid Optimization Platform
# =============================================================================

# ======================== CORE AI & ANALYTICS ================================

# Gemini API (Google AI for smart recommendations)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ======================== WEATHER & METEOROLOGICAL DATA ====================

# Open-Meteo API (Free - no key required)
NEXT_PUBLIC_OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# Weather.gov Integration (Free)
NEXT_PUBLIC_WEATHER_GOV_API=https://api.weather.gov

# ======================== SOLAR & RENEWABLE ENERGY =========================

# NASA POWER API (Free - Satellite solar radiation data)
NEXT_PUBLIC_NASA_POWER_API_URL=https://power.larc.nasa.gov/api/v1

# NREL PVWatts (Free - Solar panel performance modeling)
NEXT_PUBLIC_NREL_PVWATTS_URL=https://developer.nrel.gov/api/pvwatts/v8
NREL_API_KEY=your_nrel_free_api_key

# ======================== ELECTRICITY PRICING & GRID MARKETS ===============

# EIA (Energy Information Administration) API (Free)
EIA_API_KEY=your_eia_free_api_key
NEXT_PUBLIC_EIA_BASE_URL=https://api.eia.gov/v1

# ======================== CARBON & EMISSIONS DATA ===========================

# Open-Meteo Carbon Intensity (Free - included with weather API)
NEXT_PUBLIC_CARBON_API_URL=https://api.open-meteo.com/v1

# ======================== DISASTER & RESILIENCE DATA ========================

# USGS Earthquake Hazards (Free)
NEXT_PUBLIC_USGS_EARTHQUAKES_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0

# NOAA Hurricane Data (Free)
NOAA_HURRICANE_API=https://www.nhc.noaa.gov/gis/json

# Natural Disasters Database (Free)
NEXT_PUBLIC_DISASTER_ALERT_URL=https://www.gdacs.org/api

# Weather Alerts (Free)
NEXT_PUBLIC_FLOOD_API_URL=https://www.weather.gov/alerts

# ======================== PSO ALGORITHM CONFIGURATION =======================

# Swarm Configuration
PSO_NUM_PARTICLES=50
PSO_NUM_ITERATIONS=150
PSO_INERTIA_WEIGHT=0.7
PSO_COGNITIVE_COEFFICIENT=1.5
PSO_SOCIAL_COEFFICIENT=1.5

# Objective Weights (must sum to 100)
PSO_WEIGHT_COST=20
PSO_WEIGHT_SUSTAINABILITY=25
PSO_WEIGHT_ENERGY_OUTPUT=25
PSO_WEIGHT_RESILIENCE=15
PSO_WEIGHT_MAINTENANCE=15

# ======================== REGIONAL CONFIGURATION =============================

# Primary Region
NEXT_PUBLIC_PRIMARY_REGION=US-EAST
NEXT_PUBLIC_PRIMARY_LATITUDE=40.7128
NEXT_PUBLIC_PRIMARY_LONGITUDE=-74.0060

# Additional Regions to Monitor
NEXT_PUBLIC_SECONDARY_REGIONS=US-WEST,EU-NORTH,ASIA-EAST

# ======================== FEATURE FLAGS =====================================

NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_ADVANCED_FORECASTING=true
NEXT_PUBLIC_ENABLE_DISASTER_RESILIENCE=true
NEXT_PUBLIC_ENABLE_MICROGRID_SIMULATION=true
NEXT_PUBLIC_ENABLE_AI_SUGGESTIONS=true
NEXT_PUBLIC_ENABLE_STORAGE_OPTIMIZATION=true

# ======================== DEVELOPMENT SETTINGS ===============================

NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
DEBUG_MODE=false

# =============================================================================
# API Documentation & Registration:
# 
# FREE APIs (No key needed):
# - Open-Meteo: Weather, carbon intensity data
# - Weather.gov: US weather alerts & forecasts
# - USGS: Earthquake data
# - NOAA: Hurricane tracking
# - GDACS: Global disaster alerts
#
# FREE APIs (Free tier with registration):
# - NASA POWER: https://power.larc.nasa.gov (request form)
# - NREL PVWatts: https://developer.nrel.gov
# - EIA: https://www.eia.gov/opendata
#
# PAID APIs:
# - Gemini API: https://ai.google.dev (pay-as-you-go or subscription)
#
# Setup Instructions:
# 1. Get Gemini API key from https://ai.google.dev
# 2. Get NREL API key from https://developer.nrel.gov/signup
# 3. Get EIA API key from https://www.eia.gov/opendata/register
# 4. All other APIs are free with no registration needed
#
# Security:
# - Never commit actual API keys to version control
# - Use .env.local for local development
# - Use GitHub Secrets for production deployment
# ============================================================================= 
